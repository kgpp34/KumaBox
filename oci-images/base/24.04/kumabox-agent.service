[Unit]
Description=KumaBox guest agent
Documentation=https://github.com/kumabox/kumabox
# Boot-time tmpfiles cleanup must finish before accepting guest file writes.
# Otherwise its --remove pass can delete an in-flight upload under /tmp.
DefaultDependencies=no
Requires=kumabox-guest-prepare.service
After=kumabox-guest-prepare.service
Before=basic.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/kumabox-agent serve
Restart=always
RestartSec=2s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kumabox-agent
LimitNOFILE=65536

[Install]
WantedBy=sysinit.target
