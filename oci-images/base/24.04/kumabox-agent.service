[Unit]
Description=KumaBox guest agent
Documentation=https://github.com/kumabox/kumabox
# Native init has assembled root and /dev; the listener can start at sysinit.
DefaultDependencies=no
Before=basic.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/kumabox-agent serve
Restart=always
RestartSec=2s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kumabox-agent
LimitNOFILE=65536

[Install]
WantedBy=sysinit.target
