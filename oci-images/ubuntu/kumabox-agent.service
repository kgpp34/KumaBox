[Unit]
Description=KumaBox guest agent
Documentation=https://github.com/kumabox/kumabox
# Accept vsock work as soon as the root filesystem reaches sysinit.
DefaultDependencies=no
Before=basic.target

[Service]
Type=simple
User=root
Group=root
ExecStartPre=-/sbin/modprobe vmw_vsock_virtio_transport
ExecStart=/usr/local/bin/kumabox-agent serve
Restart=always
RestartSec=2s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kumabox-agent
LimitNOFILE=65536

[Install]
WantedBy=sysinit.target
